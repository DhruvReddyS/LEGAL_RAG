POSTGRES_DB=legal_rag
POSTGRES_USER=legal_rag
POSTGRES_PASSWORD=replace-with-a-strong-local-password
POSTGRES_PORT=5432

QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334
# Endpoints below are written from the HOST's point of view, so the backend
# works when run natively (uvicorn on this machine). The compose file pins the
# service-internal equivalents -- qdrant:6333, minio:9000,
# host.docker.internal:11434 -- for the containers, so these values are not
# consulted there and cannot break them.
QDRANT_URL=http://localhost:6333
# The corpus every reader queries and every re-index writes to.
# v2 was built in parallel and measured against v1 on golden set v3:
# R@5 0.833 -> 0.929, police R@5 0.83 -> 1.00, advocate 0.57 -> 0.71,
# citation accuracy 0.605 -> 0.614, abstention unchanged, latency
# identical. Rolling back is changing this line and restarting.
QDRANT_GLOBAL_COLLECTION=global_legal_corpus_v3
EMBEDDING_DEVICE=auto
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIMENSION=1024
QDRANT_DENSE_VECTOR_NAME=dense
QDRANT_SPARSE_VECTOR_NAME=sparse
QUERY_EMBEDDING_CACHE_SIZE=256
FAST_CANDIDATE_LIMIT=8
FAST_RESULT_LIMIT=4
FAST_LATENCY_TARGET_MS=5000
FAST_AUTO_ESCALATION_THRESHOLD=0.6
DEEP_LATENCY_TARGET_MS=300000
JOB_WORKER_ENABLED=true
JOB_POLL_INTERVAL_MS=500
FAST_REQUESTS_PER_MINUTE=30
SYNC_DEEP_REQUESTS_PER_MINUTE=2
JOB_ENQUEUES_PER_MINUTE=6
LEGACY_SYNC_LONG_RUNNING_ENABLED=true
WARM_QUERY_MODELS_ON_STARTUP=true
# Refuse to start when the embedder/reranker resolve to CPU. Set this on a
# native Apple Silicon or CUDA host; leave false inside the CPU-wheel image.
EXPECT_ACCELERATED_INFERENCE=false

BACKEND_PORT=8000

APP_ENV=development
CORS_ORIGINS=http://localhost:3000,http://localhost:5176,http://advocate.localhost:3000,http://admin.localhost:3000,http://127.0.0.1:3000,http://127.0.0.1:5176,http://127.0.0.2:3000,http://tauri.localhost,tauri://localhost
# Keep false for local/Tailscale HTTPS deployments. Enable only when a browser
# explicitly requests Private Network Access and every origin above is trusted.
CORS_ALLOW_PRIVATE_NETWORK=false
# For Tailscale Serve, add the exact MagicDNS host. For a direct bind, also add
# the exact Tailscale IP. Wildcard hosts are intentionally unsupported.
TRUSTED_HOSTS=localhost,127.0.0.1
BACKEND_BIND_ADDRESS=127.0.0.1
# Multi-device HTTPS deployment: set COOKIE_SECURE=true and COOKIE_SAMESITE=none.
# Compose defaults this to false locally; production must set it to true.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
JWT_SECRET_KEY=CHANGE_ME
JWT_REFRESH_SECRET_KEY=CHANGE_ME
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

OLLAMA_PORT=11434
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Public Ollama tag. The API pins each request to a 16,384-token context.
OLLAMA_MODEL=qwen3:14b
OLLAMA_GENERATION_CONCURRENCY=1
OLLAMA_KEEP_ALIVE=30m

S3_ENDPOINT_URL=http://localhost:9000
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY_ID=CHANGE_ME
S3_SECRET_ACCESS_KEY=CHANGE_ME
S3_BUCKET_NAME=legal-rag-documents
S3_REGION=us-east-1
S3_USE_SSL=false
S3_CORPUS_BUCKET=legal-rag-corpus
S3_POLICE_BUCKET=legal-rag-police
S3_ADVOCATE_BUCKET=legal-rag-advocate
S3_GENERATED_BUCKET=legal-rag-generated
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
LEGAL_KB_ROOT=./data/legal_kb
# Set HF_HUB_OFFLINE=1 once the embedding and reranker models are cached. The
# hub's Xet download backend can hang indefinitely on a cache revalidation
# rather than falling back to the local copy, which stalls ingestion before it
# embeds anything. Leave it unset only for the first run that fetches models.
# HF_HUB_OFFLINE=1
# HF_HOME=./data/legal_kb/cache/models
