POSTGRES_DB=legal_rag
POSTGRES_USER=legal_rag
POSTGRES_PASSWORD=replace-with-a-strong-local-password
POSTGRES_PORT=5432

QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_URL=http://qdrant:6333
EMBEDDING_DEVICE=auto
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIMENSION=1024
QDRANT_DENSE_VECTOR_NAME=dense
QDRANT_SPARSE_VECTOR_NAME=sparse
QUERY_EMBEDDING_CACHE_SIZE=256
FAST_CANDIDATE_LIMIT=8
FAST_RESULT_LIMIT=4
FAST_LATENCY_TARGET_MS=5000
DEEP_LATENCY_TARGET_MS=60000
WARM_QUERY_MODELS_ON_STARTUP=true

BACKEND_PORT=8000

APP_ENV=development
CORS_ORIGINS=http://localhost:3000,http://advocate.localhost:3000,http://admin.localhost:3000,http://127.0.0.1:3000,http://127.0.0.2:3000,http://tauri.localhost,tauri://localhost
# Keep false for local/Tailscale HTTPS deployments. Enable only when a browser
# explicitly requests Private Network Access and every origin above is trusted.
CORS_ALLOW_PRIVATE_NETWORK=false
# For Tailscale Serve, add the exact MagicDNS host. For a direct bind, also add
# the exact Tailscale IP. Wildcard hosts are intentionally unsupported.
TRUSTED_HOSTS=localhost,127.0.0.1
BACKEND_BIND_ADDRESS=127.0.0.1
# Multi-device HTTPS deployment: set COOKIE_SECURE=true and COOKIE_SAMESITE=none.
# Compose defaults this to false locally; production must set it to true.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
JWT_SECRET_KEY=CHANGE_ME
JWT_REFRESH_SECRET_KEY=CHANGE_ME
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

OLLAMA_PORT=11434
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3-14b-16k:latest

S3_ENDPOINT_URL=http://minio:9000
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY_ID=CHANGE_ME
S3_SECRET_ACCESS_KEY=CHANGE_ME
S3_BUCKET_NAME=legal-rag-documents
S3_REGION=us-east-1
S3_USE_SSL=false
S3_CORPUS_BUCKET=legal-rag-corpus
S3_POLICE_BUCKET=legal-rag-police
S3_ADVOCATE_BUCKET=legal-rag-advocate
S3_GENERATED_BUCKET=legal-rag-generated
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
LEGAL_KB_ROOT=/data/legal_kb
